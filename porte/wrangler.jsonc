{
  "$schema": "node_modules/wrangler/config-schema.json",
  // La porte des agents MEGGA (zones Europe et États-Unis), en service depuis le 15.11.2026.
  // Chaque déploiement seulement sur « Fusionne et déploie » de Julien.
  "name": "megga-agents",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  // L'adresse publique de l'entrée par API (lot 6.6) : seule /api/<client>/messages y est servie.
  // workers.dev reste l'adresse de secours, et celle de Meta, de l'administration, de l'atelier et du pilotage.
  // Prérequis : la zone megga.ai sur le compte Cloudflare de MEGGA, sinon wrangler deploy échoue.
  "routes": [{ "pattern": "api.megga.ai", "custom_domain": true }],
  "preview_urls": false,
  // Une application de conteneurs par zone, contrainte à sa juridiction.
  // La même image partout (socle/Dockerfile) ; « basic » : 1/4 vCPU, 1 Gio.
  "containers": [
    {
      "class_name": "AgentEurope",
      "image": "../socle/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 50,
      "constraints": { "jurisdiction": "eu" }
    },
    {
      "class_name": "AgentEtatsUnis",
      "image": "../socle/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 50,
      "constraints": { "jurisdiction": "us" }
    },
    {
      // L'atelier de MEGGA (lot 5) : la même image, en service « atelier ». Un seul objet (« megga ») et donc un seul
      // atelier en service ; la deuxième place laisse démarrer le conteneur d'une nouvelle image. Avec une seule,
      // le changement d'image restait bloqué après un déploiement et l'atelier répondait 1101 (« There is no container
      // instance that can be provided to this Durable Object », 15, 19 et 21.11.2026).
      "class_name": "Atelier",
      "image": "../socle/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 2,
      "constraints": { "jurisdiction": "eu" }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "AGENTS_EUROPE", "class_name": "AgentEurope" },
      { "name": "AGENTS_ETATS_UNIS", "class_name": "AgentEtatsUnis" },
      { "name": "ATELIER", "class_name": "Atelier" }
    ]
  },
  "exports": {
    "AgentEurope": { "type": "durable-object", "storage": "sqlite" },
    "AgentEtatsUnis": { "type": "durable-object", "storage": "sqlite" },
    "Atelier": { "type": "durable-object", "storage": "sqlite" }
  },
  // L'étiquette de la version déployée (wrangler deploy --tag <commit>), remise aux conteneurs.
  "version_metadata": { "binding": "VERSION_PORTE" },
  // L'adresse publique de la porte : l'atelier l'appelle pour mettre une configuration en service.
  // API_HOTE : l'hôte de l'entrée par API, qui ne sert rien d'autre.
  // COURRIEL_DE : l'expéditeur des courriels d'alerte, sur un sous-domaine à part, ouvert à Email Sending
  // (wrangler email sending enable notifications.megga.ai) : le courrier de megga.ai n'est pas touché.
  "vars": { "PORTE_URL": "https://megga-agents.api-963.workers.dev", "API_HOTE": "api.megga.ai", "COURRIEL_DE": "alertes@notifications.megga.ai" },
  // Les alertes envoyées (20.11.2026) : l'évaluation toutes les 5 minutes, et les courriels par Email Service.
  "triggers": { "crons": ["*/5 * * * *"] },
  "send_email": [{ "name": "COURRIEL" }],
  // L'annuaire des clients (D1, juridiction UE, créé le 15.11.2026).
  "d1_databases": [
    { "binding": "ANNUAIRE", "database_name": "megga-agents-annuaire", "database_id": "637715e3-6675-4310-bbdd-27a4f3b5d8c2", "migrations_dir": "migrations" }
  ]
  // Secrets (wrangler secret put) : META_APP_SECRET, META_VERIFY_TOKEN, META_TOKEN,
  // ANTHROPIC_API_KEY, DEEPSEEK_API_KEY, ELEVENLABS_API_KEY, ADMIN_TOKEN.
}
