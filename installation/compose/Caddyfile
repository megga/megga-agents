# L'entrée publique de l'installation, en HTTPS : le webhook de Meta, l'entrée par API des logiciels du
# client (docs/api.md) et son site (/site/bien, /site/demande, lot 7.4, clé SITE_CLE). Le reste de l'agent
# (/sante, routes internes) n'est jamais exposé.
{$DOMAINE} {
	handle /whatsapp {
		reverse_proxy agent:8080
	}
	handle /api/messages {
		request_body {
			max_size 16KiB
		}
		reverse_proxy agent:8080
	}
	@site path /site/bien /site/demande
	handle @site {
		request_body {
			max_size 16KiB
		}
		reverse_proxy agent:8080
	}
	handle {
		respond 404
	}
}
