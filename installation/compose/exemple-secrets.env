# À copier en secrets.env, lisible par le seul compte qui lance l'installation (chmod 600).
# Chaque secret peut aussi venir d'un fichier monté : <NOM>_FILE=/run/secrets/<nom>.
# La licence remise par MEGGA pour ce client.
MEGGA_LICENCE=
# L'app Meta du client : jeton d'accès, clé secrète (signature des webhooks), jeton d'abonnement.
META_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
# Les modèles : les comptes du client, ou ceux que MEGGA lui fournit.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Facultatif : écouter les vocaux et répondre de vive voix.
ELEVENLABS_API_KEY=
