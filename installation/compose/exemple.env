# À copier en .env (non secret). Les secrets vont dans secrets.env (exemple-secrets.env).
# L'image signée par MEGGA, par son empreinte.
MEGGA_IMAGE=ghcr.io/megga/megga-agents@sha256:<empreinte>
# Le nom de domaine public du webhook (son DNS pointe sur ce serveur, ports 80 et 443 ouverts).
DOMAINE=agent.exemple.ch
# Le mot de passe de la base Postgres de l'agent : long, aléatoire, tous caractères permis.
POSTGRES_PASSWORD=
# Le pilotage par MEGGA (docs/installation-client.md, « Le pilotage »), toujours sortant :
# non (rien ne sort), suivi (état, volumes, coûts, alertes ; jamais une conversation),
# ou complet (et MEGGA peut changer la configuration de l'agent ou proposer une version). À choisir avec MEGGA.
PILOTAGE=non
# oui : chaque changement venu de MEGGA attend votre accord (docker compose exec pilote python -m pilote ordres).
PILOTAGE_ACCORD=oui
