# La console MEGGA en local. Copier en .env.local.

# Better Auth : une clé secrète (openssl rand -base64 32) et l'adresse de la console.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# L'inscription libre en local : n'importe qui crée un compte depuis l'écran de connexion. Sans elle (en ligne), un compte ne
# se crée que depuis un lien d'invitation, et Google ou Microsoft ne créent jamais de compte.
CONSOLE_INSCRIPTION=ouverte

# Google et Microsoft : préparés, éteints tant que ces clés sont vides.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Le serveur d'agents de l'essai local (console/agents/serveur.py) et son jeton partagé. Sans AGENTS_URL (en ligne), la
# racine mène à l'admin et les routes des agents disent qu'elles ne sont pas branchées.
AGENTS_URL=http://127.0.0.1:8100
AGENTS_JETON=

# L'admin lit l'atelier (le moteur) avec le jeton de MEGGA, côté serveur seulement ; en local, l'atelier d'essai (README),
# jamais la production : ATELIER_URL=http://127.0.0.1:8198. Vide, les écrans du moteur disent qu'il n'est pas branché.
ATELIER_URL=
ATELIER_JETON=

# Facultatif : la base de la console (par défaut .donnees/console.sqlite).
# CONSOLE_BASE=

# Postgres (Neon en production) : posée, elle remplace le fichier SQLite. Vide en local.
CONSOLE_BASE_URL=
